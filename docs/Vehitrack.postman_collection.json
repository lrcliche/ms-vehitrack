                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "description": "Requiere permiso para crear usuarios y rol driver asignable. Guarda tenant_user_id en la variable tenantUserId para usarlo al crear o actualizar el conductor.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const tenantUserId = body?.data?.tenant_user_id;",
