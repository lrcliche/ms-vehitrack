{
  "info": {
    "_postman_id": "0d6b8fa6-83e0-4fe0-b218-303fb07b701a",
    "name": "VehiTrack API v2",
    "description": "Colección para endpoints v2 implementados de autenticación, rutas, operaciones empresariales, recorridos, CORS y App Driver. Importa un entorno y configura credenciales empresariales antes de iniciar sesión. El login guarda automáticamente data.access_token en token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión y guardar token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "description": "No requiere token. Configura email, password y tenantId en el entorno. El script guarda data.access_token (o data.token) en la variable token.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body?.data?.access_token || body?.data?.token || body?.access_token || body?.token;",
                  "if (token) pm.environment.set(\"token\", token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
