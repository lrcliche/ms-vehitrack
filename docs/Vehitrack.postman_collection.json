    {
      "name": "geo-rutas",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get(\"baseUrl\");\n\nconst loginResponse = await pm.sendRequest({\n  url: baseUrl+\"/api/v2/auth/login\",\n  method: \"POST\",\n  header: {\n    \"Content-Type\": \"application/json\"\n  },\n  body: {\n    mode: \"raw\",\n    raw: JSON.stringify({\n      email: \"despachador@empresa.com\",\n      password: \"UnaClaveSeguraDe12+\",\n      tenant_id: \"00000000-0000-0000-0000-000000000001\"\n    })\n  }\n});\n\nif (loginResponse.code < 200 || loginResponse.code >= 300) {\n  throw new Error(`Login falló: ${loginResponse.code} ${loginResponse.text()}`);\n}\n\nconst loginData = loginResponse.json();\nconst token = loginData?.data?.access_token || loginData.token;\n\nif (!token) {\n  throw new Error(\"La respuesta del login no contiene access_token ni token\");\n}\n\npm.variables.set(\"tokenx\", token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenx}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"waypoints\": [\n        {\n            \"lat\": 10.98,\n            \"lon\": -74.78\n        },\n        {\n            \"lat\": 10.39,\n            \"lon\": -75.47\n        }\n    ],\n    \"profile\": \"car\"\n}",
