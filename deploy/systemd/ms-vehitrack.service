[Unit]
Description=VehiTrack microservice ms-vehitrack
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/ms-vehitrack/current
EnvironmentFile=/etc/factra/env/global.env
EnvironmentFile=/etc/factra/env/ms-vehitrack.env
ExecStart=/srv/ms-vehitrack/current/ms-vehitrack
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=ms-vehitrack
StandardOutput=append:/var/log/factra/ms-vehitrack.log
StandardError=append:/var/log/factra/ms-vehitrack.error.log

[Install]
WantedBy=multi-user.target
