APP_ENV=development
HTTP_PORT=8080
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
READ_HEADER_TIMEOUT_SECONDS=5
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=65536

# Required for /api/v1/*
API_KEY=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Telemetry freshness windows
TELEMETRY_MAX_AGE_SECONDS=86400
TELEMETRY_MAX_SKEW_SECONDS=300

# PostgreSQL (optional)
POSTGRES_ENABLED=false
POSTGRES_DSN=

# Google Cloud Platform
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PUBSUB_TOPIC=
GCP_CLIENT_TIMEOUT_SECONDS=10
GCP_PUBSUB_PUBLISH_RETRIES=3
GCP_PUBSUB_RETRY_BACKOFF_MS=200

# Optional GCP adapters (disabled by default)
GCP_BIGQUERY_ENABLED=false
GCP_BIGQUERY_DATASET=
GCP_BIGQUERY_TABLE=
GCP_STORAGE_ENABLED=false
GCP_STORAGE_BUCKET=
