APP_ENV=development
HTTP_PORT=8080
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10

# DSN currently used by config loader
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/vehitrack?sslmode=disable

# Expanded DB settings for future CI/runtime integration
APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vehitrack
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Google Cloud Platform
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_BIGQUERY_DATASET=
GCP_PUBSUB_TOPIC=
GCP_STORAGE_BUCKET=
GCP_CLIENT_TIMEOUT_SECONDS=10
GCP_PUBSUB_PUBLISH_RETRIES=3
GCP_PUBSUB_RETRY_BACKOFF_MS=200
