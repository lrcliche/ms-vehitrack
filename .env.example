APP_ENV=development
HTTP_PORT=19560
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
READ_HEADER_TIMEOUT_SECONDS=5
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=65536

# Required for /api/v1/*
API_KEY=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Telemetry freshness windows
TELEMETRY_MAX_AGE_SECONDS=86400
TELEMETRY_MAX_SKEW_SECONDS=300

# PostgreSQL (optional)
# El ms se conecta como el rol de la app (vehitrack_app / vehitrack_api), NUNCA como el dueño:
# el dueño ignora RLS. DSN de ejemplo: postgres://vehitrack_api:pass@localhost:15433/vehitrack
POSTGRES_ENABLED=false
POSTGRES_DSN=

# Geo (modelo PG multi-tenant): geocoder de respaldo, ruteo y cache de resolución de tenant.
NOMINATIM_URL=http://127.0.0.1:21001
OSRM_URL=http://127.0.0.1:21002
TENANT_CACHE_TTL_SECONDS=60

# Google Cloud Platform
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PUBSUB_TOPIC=
GCP_CLIENT_TIMEOUT_SECONDS=10
GCP_PUBSUB_PUBLISH_RETRIES=3
GCP_PUBSUB_RETRY_BACKOFF_MS=200

# Optional GCP adapters (disabled by default)
GCP_BIGQUERY_ENABLED=false
GCP_BIGQUERY_DATASET=
GCP_BIGQUERY_TABLE=
GCP_STORAGE_ENABLED=false
GCP_STORAGE_BUCKET=

# Redis cache for traffic aggregates (optional)
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
TRAFFIC_CACHE_TTL_SECONDS=600
TRAFFIC_MIN_SAMPLES=5
TRAFFIC_MIN_DEVICES=3
# TomTom Flow como fuente de ARRANQUE del ETA de rutas (duration_in_traffic) mientras el
# trafico colaborativo aun no cubre. Vacio = desactivado. TRAFFIC_BASE_URL permite un proxy
# propio que replique el contrato flowSegmentData (para no exponer la key en el cliente).
TOMTOM_API_KEY=
TRAFFIC_BASE_URL=https://api.tomtom.com
